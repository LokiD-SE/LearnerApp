<?xml version="1.0" encoding="UTF-8"?>
<!--
  LearnerApp - Maven practice project (Track G).

  Each exercise is a small Maven project of its own, in src/exercises/projects/<name>. You fix its
  pom.xml; the tests in src/test/java run Maven on it and check the result (does it build, did its
  tests really run, does a failing integration test fail the build). Reference solutions are in
  src/solutions/projects/<name> (-Psolutions).

    mvn test -Dtest=ReceiptToolBuildTest      check one exercise
    cd src/exercises/projects/receipt-tool && mvn test      build the exercise project yourself
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>learnerapp</groupId>
  <artifactId>maven-practice</artifactId>
  <version>1.0.0</version>
  <name>LearnerApp Maven practice</name>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- exercises (your code) or solutions (the reference) -->
    <practice.variant>exercises</practice.variant>
    <junit.version>6.1.3</junit.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.3</version>
        <executions>
          <execution>
            <id>check-tools</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[17,)</version>
                  <message>The practice projects need Java 17 or later (java -version).</message>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.8,)</version>
                  <message>The practice projects need Maven 3.8 or later (mvn -v).</message>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- adds src/exercises/java or src/solutions/java as the main source folder -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>add-practice-sources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>src/${practice.variant}/java</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.6</version>
        <configuration>
          <trimStackTrace>true</trimStackTrace>
          <!-- the tests run Maven themselves: same Maven, and the variant to check -->
          <systemPropertyVariables>
            <maven.home>${maven.home}</maven.home>
            <practice.variant>${practice.variant}</practice.variant>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>solutions</id>
      <properties>
        <practice.variant>solutions</practice.variant>
      </properties>
    </profile>
  </profiles>
</project>
