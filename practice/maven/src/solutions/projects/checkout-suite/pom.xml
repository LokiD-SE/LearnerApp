<?xml version="1.0" encoding="UTF-8"?>
<!--
  checkout-suite - reference solution. What changed and why:
  - the excludedGroups PROPERTY (not a value inside the surefire configuration) excludes the "slow" tag;
    surefire reads it, and a command-line -DexcludedGroups= overrides it;
  - maven-failsafe-plugin runs *IT classes in the integration-test phase, and its verify goal fails the
    build afterwards if they failed - integration-test alone only records the failures.

  The build should behave like this:
    mvn test                       the fast unit tests only - not the test tagged "slow"
    mvn test -DexcludedGroups=     every unit test, the slow one too
    mvn verify                     also the integration tests (classes ending in IT)
  and a failing integration test must fail the build. Fix this pom (not the Java code).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>shop</groupId>
  <artifactId>checkout-suite</artifactId>
  <version>1.0.0</version>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <!-- read by surefire (and failsafe); -DexcludedGroups= on the command line runs everything -->
    <excludedGroups>slow</excludedGroups>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>6.1.3</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.6</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>3.5.6</version>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
