{
  "name": "Check and deploy",
  "on": {
    "push": {
      "branches": ["main"]
    },
    "pull_request": null,
    "workflow_dispatch": null
  },
  "permissions": {
    "contents": "read"
  },
  "concurrency": {
    "group": "${{ github.workflow }}-${{ github.ref }}",
    "cancel-in-progress": "${{ github.event_name == 'pull_request' }}"
  },
  "jobs": {
    "check": {
      "runs-on": "ubuntu-latest",
      "timeout-minutes": 30,
      "steps": [
        {
          "uses": "actions/checkout@v4"
        },
        {
          "uses": "actions/setup-node@v4",
          "with": {
            "node-version-file": ".nvmrc",
            "cache": "npm"
          }
        },
        {
          "run": "npm ci"
        },
        {
          "run": "npm run check"
        },
        {
          "name": "Keep test evidence when something fails",
          "if": "failure()",
          "uses": "actions/upload-artifact@v4",
          "with": {
            "name": "test-results",
            "path": "test-results",
            "retention-days": 7,
            "if-no-files-found": "ignore"
          }
        },
        {
          "name": "Upload the site",
          "if": "github.event_name != 'pull_request' && github.ref == 'refs/heads/main'",
          "uses": "actions/upload-pages-artifact@v3",
          "with": {
            "path": "dist"
          }
        }
      ]
    },
    "practice": {
      "runs-on": "ubuntu-latest",
      "timeout-minutes": 40,
      "steps": [
        {
          "uses": "actions/checkout@v4"
        },
        {
          "uses": "actions/setup-java@v4",
          "with": {
            "distribution": "temurin",
            "java-version": "21",
            "cache": "maven"
          }
        },
        {
          "run": "practice/verify.sh java"
        },
        {
          "run": "practice/verify.sh maven"
        },
        {
          "run": "practice/verify.sh framework"
        },
        {
          "uses": "actions/setup-node@v4",
          "with": {
            "node-version-file": ".nvmrc",
            "cache": "npm",
            "cache-dependency-path": "practice/playwright/package-lock.json\npractice/fullstack/package-lock.json\n"
          }
        },
        {
          "run": "practice/verify.sh playwright",
          "env": {
            "PW_CHANNEL": "chrome"
          }
        },
        {
          "run": "practice/verify.sh fullstack"
        },
        {
          "uses": "actions/setup-python@v5",
          "with": {
            "python-version-file": "practice/ai/.python-version",
            "cache": "pip",
            "cache-dependency-path": "practice/ai/requirements.txt\npractice/perf/requirements.txt\npractice/security/requirements.txt\n"
          }
        },
        {
          "run": "practice/verify.sh ai"
        },
        {
          "run": "practice/perf/scripts/get-jmeter.sh"
        },
        {
          "run": "practice/verify.sh perf"
        },
        {
          "run": "practice/verify.sh security"
        },
        {
          "name": "Keep test evidence when something fails",
          "if": "failure()",
          "uses": "actions/upload-artifact@v4",
          "with": {
            "name": "practice-evidence",
            "path": "practice/*/target/evidence\npractice/*/target/surefire-reports\n",
            "retention-days": 7,
            "if-no-files-found": "ignore"
          }
        }
      ]
    },
    "deploy": {
      "if": "github.event_name != 'pull_request' && github.ref == 'refs/heads/main'",
      "needs": ["check", "practice"],
      "runs-on": "ubuntu-latest",
      "permissions": {
        "pages": "write",
        "id-token": "write"
      },
      "environment": {
        "name": "github-pages",
        "url": "${{ steps.deployment.outputs.page_url }}"
      },
      "steps": [
        {
          "id": "deployment",
          "uses": "actions/deploy-pages@v4"
        }
      ]
    }
  }
}
