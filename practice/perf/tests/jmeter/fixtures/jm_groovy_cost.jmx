<?xml version="1.0" encoding="UTF-8"?>
<!-- The plan that recorded jm_groovy_cost.jtl (JMeter 5.6.3, 20 November 2026, -Jloops=200,
     -Jjmeter.save.saveservice.timestamp_format=HH:mm:ss.SSS so the JTL holds no epoch-ms timestamps).
     One thread runs the same HMAC-SHA256 script three ways per loop: JSR223 Groovy with the compiled script
     cached, JSR223 Groovy with cacheKey false, and a BeanShell Sampler. No HTTP - this measures only the
     scripting cost on the load generator. -->
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="script cost"/>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="TG">
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">0</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <stringProp name="LoopController.loops">${__P(loops,1000)}</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
      <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="hmac groovy cached">
        <stringProp name="scriptLanguage">groovy</stringProp>
        <stringProp name="parameters"></stringProp>
        <stringProp name="filename"></stringProp>
        <stringProp name="cacheKey">true</stringProp>
        <stringProp name="script">import javax.crypto.Mac
import javax.crypto.spec.SecretKeySpec

String body = '{"amount_minor": 1250, "currency": "EUR"}'
Mac mac = Mac.getInstance("HmacSHA256")
mac.init(new SecretKeySpec("secret-7".getBytes("UTF-8"), "HmacSHA256"))
vars.put("sig", mac.doFinal(body.getBytes("UTF-8")).encodeHex().toString())</stringProp>
      </JSR223Sampler>
      <hashTree/>
      <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="hmac groovy uncached">
        <stringProp name="scriptLanguage">groovy</stringProp>
        <stringProp name="parameters"></stringProp>
        <stringProp name="filename"></stringProp>
        <stringProp name="cacheKey">false</stringProp>
        <stringProp name="script">import javax.crypto.Mac
import javax.crypto.spec.SecretKeySpec

String body = '{"amount_minor": 1250, "currency": "EUR"}'
Mac mac = Mac.getInstance("HmacSHA256")
mac.init(new SecretKeySpec("secret-7".getBytes("UTF-8"), "HmacSHA256"))
vars.put("sig", mac.doFinal(body.getBytes("UTF-8")).encodeHex().toString())</stringProp>
      </JSR223Sampler>
      <hashTree/>
      <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="hmac beanshell">
        <stringProp name="BeanShellSampler.query">import javax.crypto.Mac;
import javax.crypto.spec.SecretKeySpec;

String body = "{\"amount_minor\": 1250, \"currency\": \"EUR\"}";
Mac mac = Mac.getInstance("HmacSHA256");
mac.init(new SecretKeySpec("secret-7".getBytes("UTF-8"), "HmacSHA256"));
byte[] raw = mac.doFinal(body.getBytes("UTF-8"));
StringBuilder hex = new StringBuilder();
for (int i = 0; i &lt; raw.length; i++) { hex.append(Integer.toHexString((raw[i] &amp; 0xff) | 0x100).substring(1)); }
vars.put("sig", hex.toString());</stringProp>
        <stringProp name="BeanShellSampler.filename"></stringProp>
        <stringProp name="BeanShellSampler.parameters"></stringProp>
        <boolProp name="BeanShellSampler.resetInterpreter">false</boolProp>
      </BeanShellSampler>
      <hashTree/>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
